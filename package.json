{
  "name": "nimbus-docs-template",
  "description": "Publish Markdown from a GitHub repository as a searchable Nimbus documentation site on Cloudflare Workers.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/deploy.mjs",
    "preview": "astro preview",
    "preview:cf": "wrangler dev",
    "e2e:dev": "wrangler dev",
    "check": "astro check",
    "typecheck": "astro check",
    "test": "vitest run",
    "config:probe": "node scripts/config-probe.mjs"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.13.0",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@iconify-json/ph": "1.2.0",
    "astro": "7.0.9",
    "astro-og-canvas": "0.13.0",
    "canvaskit-wasm": "0.41.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.5.0",
    "yaml": "2.8.2",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-gfm": "4.0.1",
    "remark-stringify": "11.0.0",
    "unist-util-visit": "5.0.0",
    "mdast-util-to-string": "4.0.0",
    "github-slugger": "2.0.0",
    "jsonc-parser": "3.3.1",
    "satteri": "0.9.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@tailwindcss/vite": "4.2.4",
    "pagefind": "1.5.2",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.127.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.2.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"]
  },
  "cloudflare": {
    "label": "Nimbus Docs",
    "products": ["Workers"],
    "categories": ["starter"],
    "docs_url": "https://developers.cloudflare.com/workers/static-assets/"
  }
}
