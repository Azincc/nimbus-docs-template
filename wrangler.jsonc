{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Preserve the existing deployment target in this standalone repository.
  "name": "nimbus-template",
  // Kept in sync with the cloudflare/templates repository linter.
  "compatibility_date": "2025-10-08",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // First-deploy inputs only. The build reads these defaults; Build variables override them.
  // Optional settings are handled by the build and can be added in Builds later.
  // DOCS_TOKEN belongs exclusively in Settings > Builds > Variables and secrets.
  "vars": {
    "DOCS_REPO": "https://github.com/Azincc/nimbus-docs-template.git",
    "DOCS_BRANCH": "main",
    "DOCS_PATH": "docs"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
